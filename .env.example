APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_PASSWORD=POSTGRESS-[PASSWORD]
POSTGRES_DB=clinical_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD-POSTGRES@localhost:5432/clinical_memory
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=JWT TOKEN SECRET KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_TEST_USER_PASSWORD=

# Gateway security defaults. Leave CORS empty unless a specific frontend origin is required.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=text/plain,application/pdf,image/png,image/jpeg,image/webp,image/tiff

# Shared AI transport defaults. Keep API keys blank in source-controlled files.
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2

# Step 1: provider-neutral OCR, VLM, and translation endpoint.
STEP1_AI_MODE=mock
STEP1_AI_PROVIDER=configured-provider
STEP1_AI_API_KEY=
STEP1_AI_ENDPOINT=

# Step 2: the existing BioClinicalBERT and Gemini adapter boundaries.
STEP2_NLP_MODE=production
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Step 4: OpenAI-compatible LLM endpoint for generated documentation drafts.
STEP4_LLM_MODE=mock
STEP4_LLM_API_KEY=
STEP4_LLM_ENDPOINT=
STEP4_LLM_MODEL=configured-model
STEP4_LLM_TIMEOUT_SECONDS=30
STEP4_LLM_MAX_RETRIES=2
