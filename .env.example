APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_PASSWORD=POSTGRESS-[PASSWORD]
POSTGRES_DB=clinical_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD-POSTGRES@localhost:5432/clinical_memory
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=JWT TOKEN SECRET KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_TEST_USER_PASSWORD=

# Gateway security defaults.
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=text/plain,application/pdf,image/png,image/jpeg,image/webp,image/tiff
# Verify uploads against their real leading bytes, not the declared MIME type.
UPLOAD_MAGIC_BYTE_CHECK=true

# Step 1: object storage for original uploaded documents.
# The code path is identical for MinIO and AWS S3; only the settings differ.
# Local (MinIO via docker compose): endpoint set, path-style addressing on.
# AWS S3: leave S3_ENDPOINT_URL empty, set S3_FORCE_PATH_STYLE=false, leave the
# credentials blank so the instance role is used, and set S3_SSE=aws:kms.
STEP1_STORAGE_MODE=mock
S3_BUCKET=clinical-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=step1
S3_SSE=none
S3_SSE_KMS_KEY_ID=
S3_PRESIGN_EXPIRY_SECONDS=300
S3_TIMEOUT_SECONDS=10
S3_MAX_RETRIES=2
# The application should not hold CreateBucket permission in a real deployment.
S3_CREATE_BUCKET_IF_MISSING=false

# MinIO credentials for local development only; compose reads these.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Persist pipeline state to PostgreSQL instead of process memory.
CLINICAL_PIPELINE_PERSISTENCE=true

# Shared AI transport defaults. Keep API keys blank in source-controlled files.
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2

# Step 1: provider-neutral OCR, VLM, and translation endpoint.
STEP1_AI_MODE=production
STEP1_AI_PROVIDER=configured-provider
STEP1_AI_API_KEY=
STEP1_AI_ENDPOINT=

# Step 2: the existing BioClinicalBERT and Gemini adapter boundaries.
STEP2_NLP_MODE=production
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_ENDPOINT=
BIOCLINICALBERT_MODEL_NAME=emilyalsentzer/Bio_ClinicalBERT
BIOCLINICALBERT_MODEL_PATH=

# Step 4: Gemini or another provider for generated documentation drafts.
STEP4_LLM_MODE=gemini
STEP4_LLM_PROVIDER=gemini
STEP4_LLM_API_KEY=
STEP4_LLM_ENDPOINT=
STEP4_LLM_MODEL=configured-model
STEP4_LLM_TIMEOUT_SECONDS=30
STEP4_LLM_MAX_RETRIES=2
